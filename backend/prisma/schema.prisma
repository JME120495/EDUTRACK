datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model School {
  id              String          @id @default(uuid())
  name            String
  logo            String?
  defaultLanguage String          @default("FR")
  phone           String?
  address         String?
  email           String?
  country         String?         @default("Cameroun")
  currency        String          @default("XAF")
  sector          String?
  levels          String?
  city            String?
  studentCount    Int?
  pdfTheme          String          @default("NAVY")
  pdfPrimaryColor   String          @default("#1E3A5F")
  pdfSecondaryColor String          @default("#F5A623")
  pdfShowBorder     Boolean         @default(true)
  subscriptionPlan  String          @default("PREMIUM") // ESSENTIAL, STANDARD, PREMIUM, CUSTOM
  subscriptionExpiresAt DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  referredById    String?
  referredBy      PlatformUser?   @relation(fields: [referredById], references: [id], onDelete: SetNull)
  influencerEarnings InfluencerEarning[]
  users           User[]
  classes         Classe[]
  matieres        Matiere[]
  creneaux        CreneauHoraire[]
  anneesScolaires AnneeScolaire[]
  transactions    Transaction[]
  documentTemplates DocumentTemplate[]
  books           Book[]
  accountingAccounts AccountingAccount[]
  accountingJournals AccountingJournal[]
  accountingFiscalYears AccountingFiscalYear[]
  accountingEntries AccountingEntry[]
}

model User {
  id              String                    @id @default(uuid())
  schoolId        String
  school          School                    @relation(fields: [schoolId], references: [id])
  name            String
  email           String                    @unique
  passwordHash    String
  role            String                    // "DIRECTOR", "TEACHER", "PARENT", "SUPPORT", "CENSEUR", "INTENDANT"
  profession      String?                   // e.g. "Gardien", "Chauffeur", "Secrétaire"
  phone           String?
  city            String?
  neighborhood    String?
  language        String                    @default("FR")
  otpCode         String?
  otpExpires      DateTime?
  emailVerified   Boolean                   @default(false)
  verificationToken String?
  verificationExpires DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  principalClasses Classe[]                 @relation("PrincipalTeacher")
  supervisedClasses Classe[]                @relation("CenseurClasses")
  taughtSubjects  EnseignantMatiereClasse[]
  children        ParentEleve[]
  timetables      EmploiDuTemps[]
  notes           Note[]
  contracts       Contract[]
  payslips        Payslip[]
  advances        SalaryAdvance[]
  leaves          StaffLeave[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  sanctionsIssued Sanction[] @relation("CenseurSanctions")
  studentProfile  Eleve?
  teacherAbsences TeacherAbsence[] @relation("TeacherAbsences")
}

model AnneeScolaire {
  id             String           @id @default(uuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  label          String           // e.g. "2025-2026"
  active         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  classes        Classe[]
  sequences      Sequence[]
  fraisScolarite FraisScolarite[]
}

model Classe {
  id                 String                    @id @default(uuid())
  schoolId           String
  school             School                    @relation(fields: [schoolId], references: [id])
  anneeScolaireId    String
  anneeScolaire      AnneeScolaire             @relation(fields: [anneeScolaireId], references: [id])
  name               String                    // e.g. "6ème A"
  principalTeacherId String?
  principalTeacher   User?                     @relation("PrincipalTeacher", fields: [principalTeacherId], references: [id])
  censeurId          String?
  censeur            User?                     @relation("CenseurClasses", fields: [censeurId], references: [id])
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  eleves             Eleve[]
  taughtSubjects     EnseignantMatiereClasse[]
  timetables         EmploiDuTemps[]
  fraisScolarite     FraisScolarite[]
}

model Eleve {
  id          String        @id @default(uuid())
  name        String
  matricule    String        @unique
  dateOfBirth  DateTime?
  placeOfBirth String?
  gender       String?
  address      String?
  photoUrl     String?
  status       String        @default("ACTIVE") // "ACTIVE", "INACTIVE"
  isSick       Boolean       @default(false)
  hasDisability Boolean      @default(false)
  medicalNotes String?
  classId      String
  class       Classe        @relation(fields: [classId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parents     ParentEleve[]
  notes       Note[]
  absences    Absence[]
  bulletins   Bulletin[]
  paiements   Paiement[]
  moratoires  Moratoire[]
  sanctions   Sanction[]
  bookLoans   BookLoan[]
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id])
  isStudentCouncil Boolean  @default(false)
}

model ParentEleve {
  parentId     String
  parent       User     @relation(fields: [parentId], references: [id])
  eleveId      String
  eleve        Eleve    @relation(fields: [eleveId], references: [id])
  relationship String?  // "FATHER", "MOTHER", "GUARDIAN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([parentId, eleveId])
}

model Matiere {
  id              String                    @id @default(uuid())
  schoolId        String
  school          School                    @relation(fields: [schoolId], references: [id])
  nameFr          String
  nameEn          String
  code            String                    // e.g. "MATH"
  coefficient     Float                     @default(1.0)
  volumeHoraire   Int                       @default(0) // Weekly hours
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  taughtBy        EnseignantMatiereClasse[]
  timetables      EmploiDuTemps[]
  notes           Note[]
  bulletinDetails BulletinDetail[]
}

model EnseignantMatiereClasse {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  matiereId String
  matiere   Matiere  @relation(fields: [matiereId], references: [id])
  classId   String
  class     Classe   @relation(fields: [classId], references: [id])
  coefficient Float?
  hourlyRate  Float    @default(0.0)
  hoursTaught Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreneauHoraire {
  id        String          @id @default(uuid())
  schoolId  String
  school    School          @relation(fields: [schoolId], references: [id])
  startTime String          // e.g. "08:00"
  endTime   String          // e.g. "10:00"
  label     String?         // e.g. "M1"
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  timetables EmploiDuTemps[]
}

model EmploiDuTemps {
  id        String         @id @default(uuid())
  classId   String
  class     Classe         @relation(fields: [classId], references: [id])
  teacherId String
  teacher   User           @relation(fields: [teacherId], references: [id])
  matiereId String
  matiere   Matiere        @relation(fields: [matiereId], references: [id])
  creneauId String
  creneau   CreneauHoraire @relation(fields: [creneauId], references: [id])
  dayOfWeek String         // "LUNDI", "MARDI", "MERCREDI", "JEUDI", "VENDREDI", "SAMEDI"
  room      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Sequence {
  id              String        @id @default(uuid())
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  name            String        // e.g. "Séquence 1"
  term            Int           // 1, 2, or 3
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notes           Note[]
  absences        Absence[]
  bulletins       Bulletin[]
}

model Note {
  id         String   @id @default(uuid())
  eleveId    String
  eleve      Eleve    @relation(fields: [eleveId], references: [id])
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id])
  matiereId  String
  matiere    Matiere  @relation(fields: [matiereId], references: [id])
  teacherId  String
  teacher    User     @relation(fields: [teacherId], references: [id])
  value      Float    // Grade out of 20
  isDraft    Boolean  @default(true)
  remarks    String?  // Behaviour / evaluation remarks
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Absence {
  id         String   @id @default(uuid())
  eleveId    String
  eleve      Eleve    @relation(fields: [eleveId], references: [id])
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id])
  date       DateTime @default(now())
  hours      Float    @default(1.0)
  justified  Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bulletin {
  id                 String           @id @default(uuid())
  eleveId            String
  eleve              Eleve            @relation(fields: [eleveId], references: [id])
  sequenceId         String?
  sequence           Sequence?        @relation(fields: [sequenceId], references: [id])
  term               Int?             // If type == "TERM"
  type               String           // "SEQUENCE" or "TERM"
  average            Float
  rank               Int?
  absencesJustified  Float            @default(0)
  absencesUnjustified Float           @default(0)
  remarks            String?
  signedDirector     Boolean          @default(false)
  signedTeacher      Boolean          @default(false)
  signedParent       Boolean          @default(false)
  pdfUrl             String?
  conduct            String?
  disciplinaryAction String?
  classCouncilDecision String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  details            BulletinDetail[]
}

model BulletinDetail {
  id           String   @id @default(uuid())
  bulletinId   String
  bulletin     Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  matiereId    String
  matiere      Matiere  @relation(fields: [matiereId], references: [id])
  noteValue    Float
  classAverage Float?
  minNote      Float?
  maxNote      Float?
  rank         Int?
  appreciation String?
  remarks      String?
  coefficient  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FraisScolarite {
  id              String        @id @default(uuid())
  classId         String
  class           Classe        @relation(fields: [classId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  totalAmount     Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  installments    InstallmentConfig[]
}

model Paiement {
  id                   String   @id @default(uuid())
  eleveId              String
  eleve                Eleve    @relation(fields: [eleveId], references: [id])
  amount               Float
  paymentDate          DateTime @default(now())
  paymentMethod        String   // "MOBILE_MONEY", "WAVE", "CASH", "BANK"
  status               String   @default("COMPLETED") // "COMPLETED", "PENDING", "FAILED"
  transactionReference String?
  payerPhone           String?
  remarks              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  installmentId        String?
  installment          InstallmentConfig? @relation(fields: [installmentId], references: [id])
}

model InstallmentConfig {
  id               String         @id @default(uuid())
  fraisScolariteId String
  fraisScolarite   FraisScolarite @relation(fields: [fraisScolariteId], references: [id], onDelete: Cascade)
  name             String         // e.g. "Tranche 1", "Inscription"
  amount           Float
  dueDate          DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payments         Paiement[]
}

model Moratoire {
  id          String   @id @default(uuid())
  eleveId     String
  eleve       Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  amount      Float
  dueDate     DateTime
  status      String   @default("PENDING") // "PENDING", "COMPLETED", "EXPIRED"
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  type          String   // "INCOME" or "EXPENSE"
  category      String   // e.g. "TUITION", "SALARY", "RENT", "EQUIPMENT", "UTILITIES", "OTHER"
  amount        Float
  date          DateTime @default(now())
  description   String
  reference     String?
  paymentMethod String   // "CASH", "BANK", "MOBILE_MONEY", "WAVE", etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contract {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String    // "CDI", "CDD", "PRESTATAIRE"
  startDate  DateTime
  endDate    DateTime?
  baseSalary Float     @default(0.0)
  hourlyRate Float     @default(0.0)
  status     String    @default("ACTIVE") // "ACTIVE", "INACTIVE"
  terms      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Payslip {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month            Int       // 1 - 12
  year             Int       // e.g. 2026
  baseSalary       Float     @default(0.0)
  hourlyRate       Float     @default(0.0)
  hoursWorked      Float     @default(0.0)
  bonuses          Float     @default(0.0) // primes
  deductions       Float     @default(0.0) // retenues
  advancesDeducted Float     @default(0.0) // advances deducted
  netSalary        Float     // net salary paid
  status           String    @default("PENDING") // "PENDING", "PAID"
  paymentDate      DateTime?
  paymentMethod    String    @default("CASH") // "CASH", "BANK", "MOBILE_MONEY"
  pdfUrl           String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SalaryAdvance {
  id             String   @id @default(uuid())
  userId         String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  requestDate    DateTime @default(now())
  status         String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "REPAID"
  repaymentMonth Int      // Month to repay
  repaymentYear  Int      // Year to repay
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StaffLeave {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "ANNUAL_LEAVE" (Congé), "PERMISSION" (Permission), "SICK_LEAVE" (Maladie), "OTHER"
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String   // e.g. "Attestation de Scolarité"
  content   String   // template body with placeholders
  language  String   @default("FR") // "FR", "EN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// V-023 FIX: Audit trail for security-sensitive actions
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // null for unauthenticated actions (failed login)
  action     String   // "LOGIN", "LOGIN_FAILED", "CREATE", "UPDATE", "DELETE", "ACCESS"
  resource   String   // "User", "Note", "Paiement", "Eleve", etc.
  resourceId String?  // ID of the affected resource
  details    String?  // JSON string with additional context
  ip         String?  // Request IP address
  userAgent  String?  // Request User-Agent
  createdAt  DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  title      String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sanction {
  id           String   @id @default(uuid())
  eleveId      String
  eleve        Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  censeurId    String
  censeur      User     @relation("CenseurSanctions", fields: [censeurId], references: [id])
  type         String   // "AVERTISSEMENT", "BLAME", "EXCLUSION_TEMP", "EXCLUSION_DEF"
  motif        String
  duration     Int?     // For EXCLUSION_TEMP
  durationType String?  // "HOURS" or "DAYS"
  isLateness   Boolean  @default(false)
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Book {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  author      String?
  isbn        String?
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loans       BookLoan[]
}

model BookLoan {
  id          String   @id @default(uuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  eleveId     String
  eleve       Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  dateEmprunt DateTime @default(now())
  dateRetour  DateTime?
  status      String   @default("ACTIVE") // "ACTIVE", "RETURNED", "LOST"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- MODULE COMPTABILITÉ ---

model AccountingAccount {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  number      String   // e.g. "411", "512"
  name        String   // e.g. "Clients", "Banque"
  type        String   // e.g. "ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lines       AccountingLine[]

  @@unique([schoolId, number])
}

model AccountingJournal {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code        String   // e.g. "BQ", "CA", "OD", "VT", "AC"
  name        String   // e.g. "Banque", "Caisse", "Opérations Diverses"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     AccountingEntry[]

  @@unique([schoolId, code])
}

model AccountingFiscalYear {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  status      String   @default("OPEN") // "OPEN", "CLOSED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     AccountingEntry[]
}

model AccountingEntry {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  journalId      String
  journal        AccountingJournal @relation(fields: [journalId], references: [id])
  fiscalYearId   String
  fiscalYear     AccountingFiscalYear @relation(fields: [fiscalYearId], references: [id])
  date           DateTime
  reference      String?  // Pièce justificative (e.g. FACT-001)
  description    String   // Libellé de l'écriture
  status         String   @default("DRAFT") // "DRAFT", "VALIDATED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lines          AccountingLine[]
}

model AccountingLine {
  id          String   @id @default(uuid())
  entryId     String
  entry       AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     AccountingAccount @relation(fields: [accountId], references: [id])
  debit       Float    @default(0.0)
  credit      Float    @default(0.0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeacherAbsence {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation("TeacherAbsences", fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  hours     Float    @default(1.0)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformUser {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            String   // "SUPER_ADMIN" ou "INFLUENCER"
  commissionRate  Float    @default(30.0)
  referralCode    String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  referredSchools School[]
  earnings        InfluencerEarning[]
}

model InfluencerEarning {
  id              String       @id @default(uuid())
  influencerId    String
  influencer      PlatformUser @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School       @relation(fields: [schoolId], references: [id])
  amountPaid      Float
  commission      Float
  date            DateTime     @default(now())
}
