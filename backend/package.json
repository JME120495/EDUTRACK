{
  "name": "edutrack-backend",
  "version": "1.0.0",
  "description": "EduTrack School Management System - Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 src/index.js",
    "dev": "nodemon --max-old-space-size=4096 src/index.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
    "prisma:generate": "npx prisma generate",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "school",
    "management",
    "bilingual"
  ],
  "author": "EduTrack",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.15.0"
  }
}
