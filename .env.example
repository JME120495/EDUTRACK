# -------------------------------------------------
# VARIABLES D'ENVIRONNEMENT - EXEMPLE
# Copiez ce fichier vers .env et remplissez les valeurs réelles
# -------------------------------------------------

# Base de données
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/nom_base?schema=public"

# Sécurité
JWT_SECRET="votre_clé_secrete_très_longue_et_aléatoire_ici"
# Exemple : ouvrez un terminal et exécutez : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Serveur
PORT=5000
NODE_ENV=development   # ou "production" en prod

# Services externes (exemple avec valeurs factices)
AFRICAS_TALKING_API_KEY="votre_cle_africas_talking_ici"
WHATSAPP_TOKEN="votre_token_whatsapp_ici"
WEBHOOK_SECRET="votre_secret_webhook_ici"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app

# Alternatif : Brevo (Sendinblue)
BREVO_API_KEY=votre_cle_brevo_ici

# URLs frontend / CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://votre-domaine.com
FRONTEND_URL=https://votre-domaine.com
